<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>InlayHtmlTemplate</RootNamespace>

    <PackageId>InlayHtmlTemplate</PackageId>
    <Version>0.1.2</Version>
    <Description>Context-aware HTML template engine for ASP.NET Core using C# string interpolation. Automatically escapes interpolated values based on HTML context (content, attributes, URLs) to prevent XSS.</Description>
    <PackageTags>inlay;html;template;xss;security;interpolation;aspnet;razor-alternative</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
